<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>10분 단위 타임 그리드 트래커</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #334155;
      --text-sub: #64748b;
      --border-color: #e2e8f0;
      /* 파스텔톤 메인/버튼 색상 */
      --primary-color: #93c5fd; /* Soft Blue */
      --primary-hover: #60a5fa;
      --danger-color: #fca5a5;  /* Soft Red */
      --warning-color: #fde047; /* Soft Yellow */
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      padding: 20px 12px;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 1100px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .card {
      background: var(--card-bg);
      border-radius: 16px;
      padding: 20px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
      border: 1px solid var(--border-color);
    }

    .header-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }

    .header-title h1 {
      font-size: 1.3rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* 날짜 선택기 스타일 */
    .date-picker-wrapper {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #f1f5f9;
      padding: 6px 12px;
      border-radius: 12px;
    }

    .date-picker-wrapper input[type="date"] {
      border: none;
      background: transparent;
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text-main);
      outline: none;
      font-family: inherit;
    }

    .control-panel { display: flex; flex-direction: column; gap: 14px; }
    .inputs-row { display: flex; gap: 10px; flex-wrap: wrap; }
    .input-group { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 160px; }
    .input-group label { font-size: 0.8rem; font-weight: 600; color: var(--text-sub); }

    input[type="text"] {
      padding: 8px 12px;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      font-size: 0.9rem;
      outline: none;
    }

    /* 파스텔 색상 선택기 */
    .color-selection { display: flex; align-items: center; gap: 8px; }
    input[type="color"] {
      -webkit-appearance: none; border: none; width: 34px; height: 34px; border-radius: 8px; cursor: pointer; background: none;
    }
    input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
    input[type="color"]::-webkit-color-swatch { border: 1px solid var(--border-color); border-radius: 8px; }

    .color-presets { display: flex; gap: 6px; }
    .color-swatch {
      width: 26px; height: 26px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: transform 0.15s;
    }
    .color-swatch:hover { transform: scale(1.1); }
    .color-swatch.active { border-color: #475569; }

    /* 액션 버튼 */
    .buttons-row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .btn {
      padding: 8px 16px; border: none; border-radius: 8px; font-size: 0.9rem; font-weight: 600; cursor: pointer;
      display: flex; align-items: center; gap: 6px; color: #1e293b; transition: opacity 0.2s;
    }
    .btn-start { background-color: var(--primary-color); }
    .btn-pause { background-color: var(--warning-color); }
    .btn-stop { background-color: var(--danger-color); }
    .btn:disabled { opacity: 0.4; cursor: not-allowed; }

    .timer-display {
      margin-left: auto; font-family: monospace; font-size: 1.1rem; font-weight: 700;
      background: #f1f5f9; padding: 6px 12px; border-radius: 8px;
    }

    .status-bar { font-size: 0.85rem; font-weight: 600; color: var(--text-sub); display: flex; align-items: center; gap: 6px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; background-color: #cbd5e1; }
    .status-dot.running { background-color: #4ade80; }
    .status-dot.paused { background-color: #facc15; }

    /* 그리드 시각화 */
    .grid-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .grid-container { display: flex; flex-direction: column; gap: 4px; }
    .hour-row { display: flex; align-items: center; gap: 6px; }
    .hour-label { width: 65px; font-size: 0.8rem; font-weight: 600; color: var(--text-sub); text-align: right; flex-shrink: 0; }
    .cells-wrapper { display: flex; gap: 4px; flex: 1; }

    .cell {
      flex: 1; height: 32px; background-color: #f1f5f9; border-radius: 4px; border: 1px solid #e2e8f0;
      cursor: pointer; position: relative; transition: all 0.15s ease;
    }
    .cell:hover { border-color: #94a3b8; transform: translateY(-1px); }

    .cell-info-tooltip {
      visibility: hidden; position: absolute; bottom: 120%; left: 50%; transform: translateX(-50%);
      background-color: #334155; color: #ffffff; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem;
      white-space: nowrap; z-index: 100; pointer-events: none; opacity: 0; transition: opacity 0.2s;
    }
    .cell:hover .cell-info-tooltip { visibility: visible; opacity: 1; }

    /* 모달 */
    .modal-overlay {
      display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(15, 23, 42, 0.3); backdrop-filter: blur(2px); z-index: 1000;
      justify-content: center; align-items: center;
    }
    .modal-overlay.active { display: flex; }
    .modal {
      background: white; border-radius: 16px; padding: 20px; width: 90%; max-width: 380px;
      display: flex; flex-direction: column; gap: 14px;
    }
    .modal-header { display: flex; justify-content: space-between; align-items: center; font-weight: 700; }
    .modal-close { background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--text-sub); }
    .modal-buttons { display: flex; justify-content: flex-end; gap: 8px; margin-top: 6px; }
  </style>
</head>
<body>

<div class="container">
  <div class="card">
    <div class="header-title">
      <h1><i class="fa-solid fa-clock-rotate-left"></i> 타임 그리드 트래커</h1>
      <div class="date-picker-wrapper">
        <i class="fa-solid fa-calendar-days" style="color:var(--text-sub);"></i>
        <input type="date" id="selectedDate" onchange="changeDate()">
      </div>
    </div>

    <div class="control-panel">
      <div class="inputs-row">
        <div class="input-group">
          <label for="titleInput">활동 제목</label>
          <input type="text" id="titleInput" placeholder="예: 코딩, 운동, 독서">
        </div>
        <div class="input-group">
          <label for="descInput">상세 내용</label>
          <input type="text" id="descInput" placeholder="예: 제미나이 프로젝트 구현">
        </div>
        <div class="input-group" style="flex: 0 0 auto;">
          <label>파스텔 색상</label>
          <div class="color-selection">
            <input type="color" id="colorPicker" value="#a7f3d0">
            <!-- 파스텔 톤 색상 프리셋 (민트, 소프트블루, 파스텔퍼플, 피치, 파스텔옐로우, 핑크) -->
            <div class="color-presets" id="colorPresets">
              <div class="color-swatch active" style="background-color: #a7f3d0;" data-color="#a7f3d0"></div>
              <div class="color-swatch" style="background-color: #bfdbfe;" data-color="#bfdbfe"></div>
              <div class="color-swatch" style="background-color: #ddd6fe;" data-color="#ddd6fe"></div>
              <div class="color-swatch" style="background-color: #fed7aa;" data-color="#fed7aa"></div>
              <div class="color-swatch" style="background-color: #fef08a;" data-color="#fef08a"></div>
              <div class="color-swatch" style="background-color: #fbcfe8;" data-color="#fbcfe8"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="buttons-row">
        <button class="btn btn-start" id="startBtn" onclick="startTimer()"><i class="fa-solid fa-play"></i> 시작</button>
        <button class="btn btn-pause" id="pauseBtn" onclick="togglePauseTimer()" disabled><i class="fa-solid fa-pause"></i> 일시정지</button>
        <button class="btn btn-stop" id="stopBtn" onclick="stopTimer()" disabled><i class="fa-solid fa-square"></i> 정지 및 기록</button>
        <div class="timer-display" id="timerDisplay">00:00:00</div>
      </div>

      <div class="status-bar">
        <div class="status-dot" id="statusDot"></div>
        <span id="statusText">대기 중</span>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="grid-header">
      <h2 style="font-size: 1rem; font-weight: 700;"><i class="fa-solid fa-table-cells"></i> 하루 시간표 (오전 05:00 ~ 익일 05:00)</h2>
      <span style="font-size:0.8rem; color:var(--text-sub);"><i class="fa-solid fa-hand-pointer"></i> 셀 클릭 시 수동 편집</span>
    </div>
    <div class="grid-container" id="gridContainer"></div>
  </div>
</div>

<!-- 수동 편집 모달 -->
<div class="modal-overlay" id="cellModal">
  <div class="modal">
    <div class="modal-header">
      <div id="modalTimeTitle">시간 블록 수동 편집</div>
      <button class="modal-close" onclick="closeModal()">&times;</button>
    </div>
    <div class="input-group">
      <label for="modalTitleInput">활동 제목</label>
      <input type="text" id="modalTitleInput">
    </div>
    <div class="input-group">
      <label for="modalDescInput">상세 내용</label>
      <input type="text" id="modalDescInput">
    </div>
    <div class="input-group">
      <label>색상 선택</label>
      <input type="color" id="modalColorPicker" style="width:100%; height:36px;">
    </div>
    <div class="modal-buttons">
      <button class="btn" style="background:#e2e8f0;" onclick="clearCellData()">삭제</button>
      <button class="btn btn-start" onclick="saveModalData()">저장</button>
    </div>
  </div>
</div>

<script>
  let timerState = 'STOPPED';
  let activeSession = null;
  let timerInterval = null;
  let elapsedTime = 0;
  let selectedColor = '#a7f3d0'; // 기본 파스텔 민트
  let targetModalCellKey = null;
  let currentDateKey = ''; // YYYY-MM-DD
  let allGridData = {};

  document.addEventListener('DOMContentLoaded', () => {
    const dateInput = document.getElementById('selectedDate');
    const today = new Date().toISOString().split('T')[0];
    dateInput.value = today;
    currentDateKey = today;

    initColorPresets();
    createGrid();
    loadAllData();
  });

  function changeDate() {
    currentDateKey = document.getElementById('selectedDate').value;
    renderCurrentDateData();
  }

  function initColorPresets() {
    const swatches = document.querySelectorAll('.color-swatch');
    const colorPicker = document.getElementById('colorPicker');

    swatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        swatches.forEach(s => s.classList.remove('active'));
        swatch.classList.add('active');
        selectedColor = swatch.getAttribute('data-color');
        colorPicker.value = selectedColor;
      });
    });

    colorPicker.addEventListener('input', (e) => {
      selectedColor = e.target.value;
      swatches.forEach(s => s.classList.remove('active'));
    });
  }

  function createGrid() {
    const gridContainer = document.getElementById('gridContainer');
    gridContainer.innerHTML = '';

    for (let i = 0; i < 24; i++) {
      let hourNum = (5 + i) % 24;
      let displayLabel = `${String(hourNum).padStart(2, '0')}:00`;
      if (i >= 19) displayLabel += ` (익일)`;

      const row = document.createElement('div');
      row.className = 'hour-row';

      const label = document.createElement('div');
      label.className = 'hour-label';
      label.innerText = displayLabel;
      row.appendChild(label);

      const cellsWrapper = document.createElement('div');
      cellsWrapper.className = 'cells-wrapper';

      for (let m = 0; m < 60; m += 10) {
        const cell = document.createElement('div');
        cell.className = 'cell';
        const cellKey = `cell-${i}-${m}`;
        cell.id = cellKey;
        cell.setAttribute('data-time', `${displayLabel.replace(' (익일)', '')}:${String(m).padStart(2, '0')}`);

        const tooltip = document.createElement('div');
        tooltip.className = 'cell-info-tooltip';
        cell.appendChild(tooltip);

        cell.addEventListener('click', () => openCellModal(cellKey, displayLabel.replace(' (익일)', ''), m));
        cellsWrapper.appendChild(cell);
      }
      row.appendChild(cellsWrapper);
      gridContainer.appendChild(row);
    }
  }

  function startTimer() {
    const title = document.getElementById('titleInput').value.trim();
    const desc = document.getElementById('descInput').value.trim();
    if (!title) { alert('제목을 입력해주세요!'); return; }

    if (timerState === 'STOPPED') {
      activeSession = { title, desc, color: selectedColor, slices: [{ start: new Date(), end: null }] };
      elapsedTime = 0;
    }

    timerState = 'RUNNING';
    updateUIForTimerState();
    timerInterval = setInterval(() => { elapsedTime++; updateTimerDisplay(); }, 1000);
  }

  function togglePauseTimer() {
    if (timerState === 'RUNNING') {
      timerState = 'PAUSED';
      clearInterval(timerInterval);
      activeSession.slices[activeSession.slices.length - 1].end = new Date();
    } else if (timerState === 'PAUSED') {
      timerState = 'RUNNING';
      activeSession.slices.push({ start: new Date(), end: null });
      timerInterval = setInterval(() => { elapsedTime++; updateTimerDisplay(); }, 1000);
    }
    updateUIForTimerState();
  }

  function stopTimer() {
    if (timerState === 'STOPPED') return;
    clearInterval(timerInterval);

    if (timerState === 'RUNNING') {
      activeSession.slices[activeSession.slices.length - 1].end = new Date();
    }

    activeSession.slices.forEach(slice => {
      if (slice.start && slice.end) {
        fillGridTimeRange(slice.start, slice.end, activeSession.title, activeSession.desc, activeSession.color);
      }
    });

    timerState = 'STOPPED';
    activeSession = null;
    elapsedTime = 0;

    updateTimerDisplay();
    updateUIForTimerState();
    saveAllData();

    document.getElementById('titleInput').value = '';
    document.getElementById('descInput').value = '';
  }

  function updateTimerDisplay() {
    const hrs = String(Math.floor(elapsedTime / 3600)).padStart(2, '0');
    const mins = String(Math.floor((elapsedTime % 3600) / 60)).padStart(2, '0');
    const secs = String(elapsedTime % 60).padStart(2, '0');
    document.getElementById('timerDisplay').innerText = `${hrs}:${mins}:${secs}`;
  }

  function updateUIForTimerState() {
    const startBtn = document.getElementById('startBtn');
    const pauseBtn = document.getElementById('pauseBtn');
    const stopBtn = document.getElementById('stopBtn');
    const statusDot = document.getElementById('statusDot');
    const statusText = document.getElementById('statusText');

    if (timerState === 'RUNNING') {
      startBtn.disabled = true; pauseBtn.disabled = false; stopBtn.disabled = false;
      pauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i> 일시정지';
      statusDot.className = 'status-dot running'; statusText.innerText = `진행 중: [${activeSession.title}]`;
    } else if (timerState === 'PAUSED') {
      startBtn.disabled = true; pauseBtn.disabled = false; stopBtn.disabled = false;
      pauseBtn.innerHTML = '<i class="fa-solid fa-play"></i> 재개';
      statusDot.className = 'status-dot paused'; statusText.innerText = `일시정지됨: [${activeSession.title}]`;
    } else {
      startBtn.disabled = false; pauseBtn.disabled = true; stopBtn.disabled = true;
      pauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i> 일시정지';
      statusDot.className = 'status-dot'; statusText.innerText = '대기 중';
    }
  }

  function fillGridTimeRange(start, end, title, desc, color) {
    let curr = new Date(start);
    while (curr <= end) {
      let hour = curr.getHours();
      let minute = curr.getMinutes();
      let hourIndex = hour >= 5 ? hour - 5 : hour + 19;
      let minuteIndex = Math.floor(minute / 10) * 10;
      let cellKey = `cell-${hourIndex}-${minuteIndex}`;

      setCellData(cellKey, { title, desc, color });
      curr.setMinutes(curr.getMinutes() + 10);
    }
  }

  function setCellData(cellKey, data) {
    if (!allGridData[currentDateKey]) allGridData[currentDateKey] = {};
    const cell = document.getElementById(cellKey);

    if (data && data.title) {
      allGridData[currentDateKey][cellKey] = data;
      if (cell) {
        cell.style.backgroundColor = data.color;
        const tooltip = cell.querySelector('.cell-info-tooltip');
        const timeStr = cell.getAttribute('data-time');
        tooltip.innerText = `[${timeStr}] ${data.title} ${data.desc ? '(' + data.desc + ')' : ''}`;
      }
    } else {
      delete allGridData[currentDateKey][cellKey];
      if (cell) {
        cell.style.backgroundColor = '#f1f5f9';
        const tooltip = cell.querySelector('.cell-info-tooltip');
        tooltip.innerText = '';
      }
    }
  }

  function renderCurrentDateData() {
    // 그리드 초기화
    document.querySelectorAll('.cell').forEach(cell => {
      cell.style.backgroundColor = '#f1f5f9';
      cell.querySelector('.cell-info-tooltip').innerText = '';
    });

    const dayData = allGridData[currentDateKey] || {};
    Object.keys(dayData).forEach(cellKey => {
      const data = dayData[cellKey];
      const cell = document.getElementById(cellKey);
      if (cell && data) {
        cell.style.backgroundColor = data.color;
        const tooltip = cell.querySelector('.cell-info-tooltip');
        const timeStr = cell.getAttribute('data-time');
        tooltip.innerText = `[${timeStr}] ${data.title} ${data.desc ? '(' + data.desc + ')' : ''}`;
      }
    });
  }

  function openCellModal(cellKey, hourStr, min) {
    targetModalCellKey = cellKey;
    const timeStr = `${hourStr}:${String(min).padStart(2, '0')}`;
    document.getElementById('modalTimeTitle').innerText = `${timeStr} 블록 설정`;

    const dayData = allGridData[currentDateKey] || {};
    const existingData = dayData[cellKey] || {};

    document.getElementById('modalTitleInput').value = existingData.title || document.getElementById('titleInput').value || '';
    document.getElementById('modalDescInput').value = existingData.desc || document.getElementById('descInput').value || '';
    document.getElementById('modalColorPicker').value = existingData.color || selectedColor;

    document.getElementById('cellModal').classList.add('active');
  }

  function closeModal() {
    document.getElementById('cellModal').classList.remove('active');
    targetModalCellKey = null;
  }

  function saveModalData() {
    if (!targetModalCellKey) return;
    const title = document.getElementById('modalTitleInput').value.trim();
    const desc = document.getElementById('modalDescInput').value.trim();
    const color = document.getElementById('modalColorPicker').value;

    if (!title) { alert('제목을 입력해주세요.'); return; }

    setCellData(targetModalCellKey, { title, desc, color });
    saveAllData();
    closeModal();
  }

  function clearCellData() {
    if (!targetModalCellKey) return;
    setCellData(targetModalCellKey, null);
    saveAllData();
    closeModal();
  }

  function saveAllData() {
    localStorage.setItem('allTimeGridData', JSON.stringify(allGridData));
  }

  function loadAllData() {
    const saved = localStorage.getItem('allTimeGridData');
    if (saved) {
      allGridData = JSON.parse(saved);
      renderCurrentDateData();
    }
  }
</script>
</body>
</html>
